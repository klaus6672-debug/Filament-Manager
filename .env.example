# Kopiere diese Datei nach ".env" und passe die Werte an.
FMT_PASSWORD=HIER-EIN-EIGENES-PASSWORT
FMT_USER=fmt
# IP-Adresse (oder Name) des Mini-PCs im Heimnetz, so wie du sie am Handy eintippst:
FMT_HOST=192.168.1.50
# Ordner für die Datenbank (Windows-Pfad mit normalen Schrägstrichen):
FILAMENT_DATA=D:/Filament
# Ports (nur ändern, wenn sie belegt sind):
FILAMENT_HTTPS_PORT=8443
FILAMENT_HTTP_PORT=8080

# Optional: AMS-Live-Abgleich mit Home Assistant (nur nötig, wenn die App nicht als HA-Add-on läuft)
# HA_URL=http://192.168.178.50:8123
# HA_TOKEN=
